{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "How State Food Price Rankings Have Shifted",
    "subtitle": "Annual rank of each state's food Customer Price Index (1 = highest prices).",
    "anchor": "start",
    "fontSize": 15,
    "subtitleFontSize": 12
  },
  "width": "container",
  "height": 400,
  "layer": [
    {
      "data": {"url": "data/cpi_state.csv"},
      "transform": [
        {"filter": "datum.division == '01'"},
        {"calculate": "year(datum.date)", "as": "year"},
        {"filter": "datum.year >= 2018"},
        {
          "aggregate": [
            {"op": "mean", "field": "index", "as": "avg_index"}
          ],
          "groupby": ["state", "year"]
        },
        {
          "window": [
            {"op": "rank", "field": "avg_index", "as": "rank"}
          ],
          "sort": [{"field": "avg_index", "order": "descending"}],
          "groupby": ["year"]
        }
      ],
      "mark": {"type": "line", "strokeWidth": 1.5, "point": true},
      "encoding": {
        "x": {"field": "year", "type": "ordinal", "title": "Year"},
        "y": {
          "field": "rank",
          "type": "quantitative",
          "title": "Rank (1 = highest food prices)",
          "scale": {"domain": [1, 16]}
        },
        "color": {
          "field": "state",
          "type": "nominal",
          "scale": {"scheme": "tableau20"},
          "legend": {"title": "State", "orient": "right"}
        },
        "opacity": {
          "condition": {
            "test": "datum.state == 'Selangor' || datum.state == 'W.P. Kuala Lumpur' || datum.state == 'Sabah' || datum.state == 'Kelantan'",
            "value": 1
          },
          "value": 0.15
        },
        "tooltip": [
          {"field": "state", "title": "State"},
          {"field": "year", "title": "Year"},
          {"field": "rank", "title": "Rank"}
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "year": 2023,
            "rank": 2,
            "label": "Sabah: stays top 3"
          },
          {
            "year": 2023,
            "rank": 5,
            "label": "Kelantan: climbs"
          },
          {
            "year": 2023,
            "rank": 8,
            "label": "Selangor: mid-tier"
          },
          {
            "year": 2023,
            "rank": 13,
            "label": "KL: drops over time"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 6,
        "fontSize": 10.5,
        "color": "black"
      },
      "encoding": {
        "x": {"field": "year", "type": "ordinal"},
        "y": {"field": "rank", "type": "quantitative"},
        "text": {"field": "label"}
      }
    }
  ]
}
