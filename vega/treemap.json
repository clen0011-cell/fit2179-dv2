{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "What Makes Up Malaysia's Price Basket?",
    "subtitle": "Share of each category in the CPI basket, 2024.",
    "anchor": "start",
    "fontSize": 15,
    "subtitleFontSize": 12
  },
  "width": "container",
  "height": 320,
  "layer": [
    {
      "data": {
        "values": [
          {"category": "Food & Drinks",        "weight": 29.5},
          {"category": "Housing & Utilities",  "weight": 23.8},
          {"category": "Transport",            "weight": 14.6},
          {"category": "Restaurants & Hotels", "weight": 9.4},
          {"category": "Health",               "weight": 6.0},
          {"category": "Education",            "weight": 5.0},
          {"category": "Furnishings",          "weight": 4.2},
          {"category": "Recreation",           "weight": 3.5},
          {"category": "Clothing",             "weight": 2.1},
          {"category": "Communication",        "weight": 1.9}
        ]
      },
      "mark": {"type": "bar", "cornerRadiusEnd": 4},
      "encoding": {
        "y": {"field": "category", "type": "nominal", "sort": "-x", "title": null},
        "x": {
          "field": "weight", "type": "quantitative",
          "title": "Share of CPI Basket (%)",
          "axis": {"grid": false}
        },
        "color": {"value": "#4a7c6f"},
        "tooltip": [
          {"field": "category", "title": "Category"},
          {"field": "weight",   "title": "Basket Share (%)", "format": ".1f"}
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 18,
            "category": "Food & Drinks",
            "label": "food + housing = 53%"
          },
          {
            "x": 5,
            "category": "Communication",
            "label": "smallest basket share"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 10.5,
        "color": "#000000",
        "align": "left",
        "dx": 6
      },
      "encoding": {
        "x": {"field": "x", "type": "quantitative"},
        "y": {"field": "category", "type": "nominal"},
        "text": {"field": "label"}
      }
    }
  ]
}
