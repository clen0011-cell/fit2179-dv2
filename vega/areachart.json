{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Eating Out vs Cooking at Home",
    "subtitle": "CPI index for Food at Home (div 01) vs Restaurants & Hotels (div 11)",
    "anchor": "start",
    "fontSize": 15,
    "subtitleFontSize": 12
  },
  "width": "container",
  "height": 300,
  "data": {"url": "data/cpi_national.csv"},
  "transform": [
    {"filter": "datum.division == '01' || datum.division == '11'"},
    {
      "calculate": "datum.division == '01' ? 'Food at Home' : 'Eating Out'",
      "as": "category"
    }
  ],
  "mark": {
    "type": "area",
    "opacity": 0.7,
    "line": true
  },
  "encoding": {
    "x": {
      "field": "date",
      "type": "temporal",
      "title": "Year"
    },
    "y": {
      "field": "index",
      "type": "quantitative",
      "title": "CPI Index (2010 = 100)",
      "stack": null
    },
    "color": {
      "field": "category",
      "type": "nominal",
      "scale": {
        "domain": ["Food at Home", "Eating Out"],
        "range": ["#f4a261", "#c0392b"]
      },
      "legend": {"title": null, "orient": "top-left"}
    },
    "tooltip": [
      {"field": "date", "type": "temporal", "title": "Date"},
      {"field": "category", "title": "Type"},
      {"field": "index", "title": "CPI Index", "format": ".1f"}
    ]
  }
}
