{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Food Inflation Across States Over Time",
    "subtitle": "Annual % change in food Customer Price Index by state, 2015-2025.",
    "anchor": "start",
    "fontSize": 15,
    "subtitleFontSize": 12
  },
  "width": "container",
  "height": 350,
  "layer": [
    {
      "data": {"url": "data/cpi_state_inflation.csv"},
      "transform": [
        {"filter": "datum.division == '01'"},
        {"filter": "datum.inflation_yoy != ''"},
        {"calculate": "year(datum.date)", "as": "year"},
        {"filter": "datum.year >= 2015"},
        {
          "aggregate": [{"op": "mean", "field": "inflation_yoy", "as": "avg_inflation"}],
          "groupby": ["state", "year"]
        }
      ],
      "mark": "rect",
      "encoding": {
        "x": {"field": "year", "type": "ordinal", "title": "Year"},
        "y": {"field": "state", "type": "nominal", "title": null},
        "color": {
          "field": "avg_inflation",
          "type": "quantitative",
          "scale": {"scheme": "blues", "domain": [0, 8]},
          "legend": {"title": "Inflation %"}
        },
        "tooltip": [
          {"field": "state", "title": "State"},
          {"field": "year", "title": "Year"},
          {"field": "avg_inflation", "title": "Food Inflation %", "format": ".1f"}
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "year": 2022,
            "state": "Selangor",
            "label": "Inflation spike period"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 13,
        "dy": -15,
        "color": "black",
        "stroke": "white",
        "strokeWidth": 0.2,
        "strokeOpacity": 1
      },
      "encoding": {
        "x": {"field": "year", "type": "ordinal"},
        "y": {"field": "state", "type": "nominal"},
        "text": {"field": "label"}
      }
    }
  ]
}
