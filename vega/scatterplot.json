{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Do Richer States Spend More on Food?",
    "subtitle": "Mean household income vs mean expenditure by state, 2022. Source: DOSM HIES",
    "anchor": "start",
    "fontSize": 15,
    "subtitleFontSize": 12
  },
  "width": "container",
  "height": 360,
  "data": {"url": "data/hies_state.csv"},
  "layer": [
    {
      "mark": {"type": "point", "filled": true, "size": 120, "opacity": 0.85},
      "encoding": {
        "x": {
          "field": "income_mean",
          "type": "quantitative",
          "title": "Mean Household Income (RM/month)",
          "axis": {"grid": false}
        },
        "y": {
          "field": "expenditure_mean",
          "type": "quantitative",
          "title": "Mean Household Expenditure (RM/month)",
          "axis": {"grid": false}
        },
        "color": {
          "field": "poverty",
          "type": "quantitative",
          "scale": {"scheme": "blues"},
          "legend": {"title": "Poverty Rate (%)"}
        },
        "size": {
          "field": "poverty",
          "type": "quantitative",
          "scale": {"range": [60, 400]},
          "legend": null
        },
        "tooltip": [
          {"field": "state",            "title": "State"},
          {"field": "income_mean",      "title": "Mean Income (RM)",      "format": ",.0f"},
          {"field": "expenditure_mean", "title": "Mean Expenditure (RM)", "format": ",.0f"},
          {"field": "poverty",          "title": "Poverty Rate (%)",      "format": ".1f"}
        ]
      }
    },
    {
      "mark": {"type": "text", "dy": -12, "fontSize": 9, "color": "#555"},
      "encoding": {
        "x": {"field": "income_mean",      "type": "quantitative"},
        "y": {"field": "expenditure_mean", "type": "quantitative"},
        "text": {"field": "state"}
      }
    }
  ]
}
