{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Do Richer States Spend More on Food?",
    "subtitle": "Mean household income vs mean expenditure by state, 2022. Source: DOSM HIES",
    "anchor": "start",
    "fontSize": 15,
    "subtitleFontSize": 12
  },
  "width": "container",
  "height": 360,
  "data": {"url": "data/hies_state.csv"},
  "layer": [
    {
      "mark": {"type": "point", "filled": true, "size": 100, "opacity": 0.75},
      "encoding": {
        "x": {
          "field": "income_mean",
          "type": "quantitative",
          "title": "Mean Household Income (RM/month)",
          "axis": {"grid": false},
          "scale": {"zero": false}
        },
        "y": {
          "field": "expenditure_mean",
          "type": "quantitative",
          "title": "Mean Household Expenditure (RM/month)",
          "axis": {"grid": false},
          "scale": {"zero": false}
        },
        "color": {
          "field": "poverty",
          "type": "quantitative",
          "scale": {"scheme": "blues"},
          "legend": {"title": "Poverty Rate (%)"}
        },
        "size": {
          "field": "poverty",
          "type": "quantitative",
          "scale": {"range": [60, 400]},
          "legend": null
        },
        "tooltip": [
          {"field": "state",            "title": "State"},
          {"field": "income_mean",      "title": "Mean Income (RM)",      "format": ",.0f"},
          {"field": "expenditure_mean", "title": "Mean Expenditure (RM)", "format": ",.0f"},
          {"field": "poverty",          "title": "Poverty Rate (%)",      "format": ".1f"}
        ]
      }
    },
    {
      "data": {
        "values": [
          {"state": "Kelantan",         "income_mean": 4885,  "expenditure_mean": 3505, "label": "Kelantan\n(Lowest income)", "ax": -10, "ay": -25},
          {"state": "Sabah",            "income_mean": 6171,  "expenditure_mean": 3342, "label": "Sabah\n(Lowest expenditure)", "ax": 10, "ay": 25},
          {"state": "W.P. Putrajaya",   "income_mean": 13473, "expenditure_mean": 8897, "label": "W.P. Putrajaya\n(Highest income & spend)", "ax": -15, "ay": -25},
          {"state": "W.P. Kuala Lumpur","income_mean": 13325, "expenditure_mean": 7823, "label": "W.P. Kuala Lumpur", "ax": -15, "ay": 20}
        ]
      },
      "layer": [
        {
          "mark": {"type": "point", "filled": true, "size": 130, "opacity": 1, "color": "#D55E00"},
          "encoding": {
            "x": {"field": "income_mean",      "type": "quantitative"},
            "y": {"field": "expenditure_mean", "type": "quantitative"}
          }
        },
        {
          "mark": {
            "type": "text",
            "fontSize": 10,
            "fontWeight": "bold",
            "color": "#D55E00",
            "lineBreak": "\n"
          },
          "encoding": {
            "x":    {"field": "income_mean",      "type": "quantitative"},
            "y":    {"field": "expenditure_mean", "type": "quantitative"},
            "text": {"field": "label"},
            "dx":   {"field": "ax"},
            "dy":   {"field": "ay"}
          }
        }
      ]
    }
  ]
}
