{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Do Richer States Spend More on Food?",
    "subtitle": "Mean household income vs mean expenditure by state, 2022.",
    "anchor": "start",
    "fontSize": 15,
    "subtitleFontSize": 12
  },
  "width": "container",
  "height": 360,
  "data": {"url": "data/hies_state.csv"},
  "layer": [
    {
      "mark": {
        "type": "line",
        "color": "#cccccc",
        "strokeWidth": 1.5,
        "strokeDash": [4, 3]
      },
      "transform": [
        {
          "regression": "expenditure_mean",
          "on": "income_mean"
        }
      ],
      "encoding": {
        "x": {
          "field": "income_mean",
          "type": "quantitative",
          "scale": {"zero": false}
        },
        "y": {
          "field": "expenditure_mean",
          "type": "quantitative",
          "scale": {"zero": false}
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 80,
        "opacity": 0.6,
        "color": "#56B4E9"
      },
      "encoding": {
        "x": {
          "field": "income_mean",
          "type": "quantitative",
          "title": "Mean Household Income (RM/month)",
          "axis": {"grid": false},
          "scale": {"zero": false}
        },
        "y": {
          "field": "expenditure_mean",
          "type": "quantitative",
          "title": "Mean Household Expenditure (RM/month)",
          "axis": {"grid": false},
          "scale": {"zero": false}
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State"
          },
          {
            "field": "income_mean",
            "title": "Mean Income (RM)",
            "format": ",.0f"
          },
          {
            "field": "expenditure_mean",
            "title": "Mean Expenditure (RM)",
            "format": ",.0f"
          },
          {
            "field": "poverty",
            "title": "Poverty Rate (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 7000,
            "y": 8000,
            "label": "Higher income → higher spending"
          },
          {
            "x": 7000,
            "y": 7750,
            "label": "KL & Putrajaya lead both"
          },
          {
            "x": 7000,
            "y": 7500,
            "label": "Sabah = notable outlier"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 10.5,
        "color": "#000000",
        "align": "left"
      },
      "encoding": {
        "x": {"field": "x", "type": "quantitative"},
        "y": {"field": "y", "type": "quantitative"},
        "text": {"field": "label"}
      }
    }
  ]
}
