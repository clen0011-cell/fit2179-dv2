{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Do Richer States Spend More on Food?",
    "subtitle": "Mean household income vs mean expenditure by state, 2022.",
    "anchor": "start",
    "fontSize": 15,
    "subtitleFontSize": 12
  },
  "width": "container",
  "height": 360,
  "data": {"url": "data/hies_state.csv"},
  "layer": [
    {
      "data": {
        "values": [
          {"i": 4885,  "e": 3505,  "s": "Kelantan"},
          {"i": 5550,  "e": 3765,  "s": "Kedah"},
          {"i": 5664,  "e": 3834,  "s": "Perlis"},
          {"i": 5777,  "e": 4107,  "s": "Pahang"},
          {"i": 5779,  "e": 3903,  "s": "Perak"},
          {"i": 6171,  "e": 3342,  "s": "Sabah"},
          {"i": 6457,  "e": 3915,  "s": "Sarawak"},
          {"i": 6788,  "e": 4678,  "s": "Negeri Sembilan"},
          {"i": 7248,  "e": 4796,  "s": "Terengganu"},
          {"i": 8057,  "e": 5707,  "s": "Melaka"},
          {"i": 8250,  "e": 4176,  "s": "W.P. Labuan"},
          {"i": 8267,  "e": 5322,  "s": "Pulau Pinang"},
          {"i": 8517,  "e": 5342,  "s": "Johor"},
          {"i": 12233, "e": 6770,  "s": "Selangor"},
          {"i": 13325, "e": 7823,  "s": "W.P. Kuala Lumpur"},
          {"i": 13473, "e": 8897,  "s": "W.P. Putrajaya"}
        ]
      },
      "mark": {
        "type": "line",
        "color": "black",
        "strokeWidth": 1.5,
        "opacity": 0.6,
        "interpolate": "monotone"
      },
      "encoding": {
        "x": {
          "field": "i",
          "type": "quantitative",
          "axis": {"grid": false},
          "scale": {"zero": false}
        },
        "y": {
          "field": "e",
          "type": "quantitative",
          "axis": {"grid": false},
          "scale": {"zero": false}
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 80,
        "opacity": 0.75,
        "color": "#56B4E9"
      },
      "encoding": {
        "x": {
          "field": "income_mean",
          "type": "quantitative",
          "title": "Mean Household Income (RM/month)",
          "axis": {"grid": false},
          "scale": {"zero": false}
        },
        "y": {
          "field": "expenditure_mean",
          "type": "quantitative",
          "title": "Mean Household Expenditure (RM/month)",
          "axis": {"grid": false},
          "scale": {"zero": false}
        },
        "tooltip": [
          {"field": "state", "title": "State"},
          {
            "field": "income_mean",
            "title": "Mean Income (RM)",
            "format": ",.0f"
          },
          {
            "field": "expenditure_mean",
            "title": "Mean Expenditure (RM)",
            "format": ",.0f"
          },
          {
            "field": "poverty",
            "title": "Poverty Rate (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 7200,
            "y": 8200,
            "label": "Higher income → higher spending"
          },
          {
            "x": 7200,
            "y": 7950,
            "label": "KL & Putrajaya lead both"
          },
          {
            "x": 7200,
            "y": 7700,
            "label": "Sabah = notable outlier"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 10.5,
        "color": "black",
        "align": "left"
      },
      "encoding": {
        "x": {"field": "x", "type": "quantitative"},
        "y": {"field": "y", "type": "quantitative"},
        "text": {"field": "label"}
      }
    }
  ]
}
