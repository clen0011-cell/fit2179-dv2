{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Do Richer States Spend More on Food?",
    "subtitle": "Mean household income vs mean expenditure by state, 2022. Source: DOSM HIES",
    "anchor": "start",
    "fontSize": 15,
    "subtitleFontSize": 12
  },
  "width": "container",
  "height": 360,
  "data": {"url": "data/hies_state.csv"},
  "layer": [
    {
      "mark": {"type": "point", "filled": true, "size": 80, "opacity": 0.6, "color": "#90bcd4"},
      "encoding": {
        "x": {
          "field": "income_mean",
          "type": "quantitative",
          "title": "Mean Household Income (RM/month)",
          "axis": {"grid": false},
          "scale": {"zero": false}
        },
        "y": {
          "field": "expenditure_mean",
          "type": "quantitative",
          "title": "Mean Household Expenditure (RM/month)",
          "axis": {"grid": false},
          "scale": {"zero": false}
        },
        "tooltip": [
          {"field": "state",            "title": "State"},
          {"field": "income_mean",      "title": "Mean Income (RM)",      "format": ",.0f"},
          {"field": "expenditure_mean", "title": "Mean Expenditure (RM)", "format": ",.0f"},
          {"field": "poverty",          "title": "Poverty Rate (%)",      "format": ".1f"}
        ]
      }
    },
    {
      "data": {
        "values": [
          {"state": "Kelantan",          "income_mean": 4885,  "expenditure_mean": 3505},
          {"state": "Sabah",             "income_mean": 6171,  "expenditure_mean": 3342},
          {"state": "W.P. Putrajaya",    "income_mean": 13473, "expenditure_mean": 8897},
          {"state": "W.P. Kuala Lumpur", "income_mean": 13325, "expenditure_mean": 7823}
        ]
      },
      "mark": {"type": "point", "filled": true, "size": 120, "opacity": 1, "color": "#D55E00"},
      "encoding": {
        "x": {"field": "income_mean",      "type": "quantitative"},
        "y": {"field": "expenditure_mean", "type": "quantitative"}
      }
    },
    {
      "data": {
        "values": [
          {"income_mean": 5800,  "expenditure_mean": 3800,  "label": "Kelantan — lowest income & expenditure"},
          {"income_mean": 11000, "expenditure_mean": 3200,  "label": "Sabah — low expenditure despite mid income"},
          {"income_mean": 11500, "expenditure_mean": 8700,  "label": "W.P. Putrajaya — highest income & spend"},
          {"income_mean": 11500, "expenditure_mean": 8200,  "label": "W.P. Kuala Lumpur"}
        ]
      },
      "mark": {"type": "text", "fontSize": 10, "color": "#D55E00", "align": "left"},
      "encoding": {
        "x":    {"field": "income_mean",      "type": "quantitative"},
        "y":    {"field": "expenditure_mean", "type": "quantitative"},
        "text": {"field": "label"}
      }
    }
  ]
}
