{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Do Richer States Spend More on Food?",
    "subtitle": "Mean household income vs mean expenditure by state, 2022.",
    "anchor": "start",
    "fontSize": 15,
    "subtitleFontSize": 12
  },
  "width": "container",
  "height": 360,
  "data": {"url": "data/hies_state.csv"},
  "layer": [
    {
      "data": {
        "values": [
          {"income_mean": 4686,  "expenditure_mean": 3514},
          {"income_mean": 5184,  "expenditure_mean": 3810},
          {"income_mean": 5617,  "expenditure_mean": 3924},
          {"income_mean": 5703,  "expenditure_mean": 4138},
          {"income_mean": 5972,  "expenditure_mean": 3873},
          {"income_mean": 6108,  "expenditure_mean": 4628},
          {"income_mean": 6230,  "expenditure_mean": 4529},
          {"income_mean": 6352,  "expenditure_mean": 4762},
          {"income_mean": 6555,  "expenditure_mean": 4459},
          {"income_mean": 7524,  "expenditure_mean": 4198},
          {"income_mean": 7914,  "expenditure_mean": 5592},
          {"income_mean": 8013,  "expenditure_mean": 5340},
          {"income_mean": 8016,  "expenditure_mean": 5421},
          {"income_mean": 8072,  "expenditure_mean": 5357},
          {"income_mean": 12396, "expenditure_mean": 6697},
          {"income_mean": 13809, "expenditure_mean": 8903}
        ]
      },
      "mark": {
        "type": "line",
        "color": "#E69F00",
        "strokeWidth": 1.5,
        "opacity": 0.6,
        "interpolate": "monotone"
      },
      "encoding": {
        "x": {
          "field": "income_mean",
          "type": "quantitative",
          "axis": {"grid": false},
          "scale": {"zero": false}
        },
        "y": {
          "field": "expenditure_mean",
          "type": "quantitative",
          "axis": {"grid": false},
          "scale": {"zero": false}
        },
        "order": {
          "field": "income_mean",
          "sort": "ascending"
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 80,
        "opacity": 0.75,
        "color": "#56B4E9"
      },
      "encoding": {
        "x": {
          "field": "income_mean",
          "type": "quantitative",
          "title": "Mean Household Income (RM/month)",
          "axis": {"grid": false},
          "scale": {"zero": false}
        },
        "y": {
          "field": "expenditure_mean",
          "type": "quantitative",
          "title": "Mean Household Expenditure (RM/month)",
          "axis": {"grid": false},
          "scale": {"zero": false}
        },
        "tooltip": [
          {"field": "state", "title": "State"},
          {
            "field": "income_mean",
            "title": "Mean Income (RM)",
            "format": ",.0f"
          },
          {
            "field": "expenditure_mean",
            "title": "Mean Expenditure (RM)",
            "format": ",.0f"
          },
          {
            "field": "poverty",
            "title": "Poverty Rate (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 7000,
            "y": 8000,
            "label": "Higher income → higher spending"
          },
          {
            "x": 7000,
            "y": 7750,
            "label": "KL & Putrajaya lead both"
          },
          {
            "x": 7000,
            "y": 7500,
            "label": "Sabah = notable outlier"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 10.5,
        "color": "#000000",
        "align": "left"
      },
      "encoding": {
        "x": {"field": "x", "type": "quantitative"},
        "y": {"field": "y", "type": "quantitative"},
        "text": {"field": "label"}
      }
    }
  ]
}
