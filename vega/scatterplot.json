{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Do Richer States Spend More on Food?",
    "subtitle": "Mean household income vs mean expenditure by state, 2022.",
    "anchor": "start",
    "fontSize": 15,
    "subtitleFontSize": 12
  },
  "width": "container",
  "height": 360,
  "data": {"url": "data/hies_state.csv"},
  "layer": [
    {
      "mark": {"type": "point", "filled": true, "size": 80, "opacity": 0.6, "color": "#90bcd4"},
      "encoding": {
        "x": {
          "field": "income_mean", "type": "quantitative",
          "title": "Mean Household Income (RM/month)",
          "axis": {"grid": false}, "scale": {"zero": false}
        },
        "y": {
          "field": "expenditure_mean", "type": "quantitative",
          "title": "Mean Household Expenditure (RM/month)",
          "axis": {"grid": false}, "scale": {"zero": false}
        },
        "tooltip": [
          {"field": "state",            "title": "State"},
          {"field": "income_mean",      "title": "Mean Income (RM)",      "format": ",.0f"},
          {"field": "expenditure_mean", "title": "Mean Expenditure (RM)", "format": ",.0f"},
          {"field": "poverty",          "title": "Poverty Rate (%)",      "format": ".1f"}
        ]
      }
    },
    {
      "data": {
        "values": [
          {"x": 4200, "y": 8600, "label": "Richer states spend more."},
          {"x": 4200, "y": 8200, "label": "KL & Putrajaya → top both axes."},
          {"x": 4200, "y": 7800, "label": "Kelantan → lowest; Sabah outlier."}
        ]
      },
      "mark": {
        "type": "text", "fontSize": 10.5, "color": "#555",
        "align": "left", "fontStyle": "italic"
      },
      "encoding": {
        "x":    {"field": "x", "type": "quantitative"},
        "y":    {"field": "y", "type": "quantitative"},
        "text": {"field": "label"}
      }
    }
  ]
}
