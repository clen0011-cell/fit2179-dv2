{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Food Price Inflation by Malaysian State",
    "subtitle": "Annual % change in food CPI (2023–2024)",
    "anchor": "start",
    "fontSize": 15,
    "subtitleFontSize": 12
  },
  "width": "container",
  "height": 400,
  "projection": {"type": "equirectangular"},
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/dosm-malaysia/data-open/main/datasets/geo/administrative/state.geojson",
        "format": {"type": "json", "property": "features"}
      },
      "transform": [
        {
          "lookup": "properties.state",
          "from": {
            "data": {"url": "data/cpi_state_inflation.csv"},
            "key": "state",
            "fields": ["inflation_yoy"]
          }
        },
        {"filter": "datum.inflation_yoy != null"}
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#fff",
        "strokeWidth": 0.8
      },
      "encoding": {
        "color": {
          "field": "inflation_yoy",
          "type": "quantitative",
          "scale": {"scheme": "orangered"},
          "legend": {"title": "Inflation %"}
        },
        "tooltip": [
          {"field": "properties.state", "title": "State"},
          {"field": "inflation_yoy", "title": "Food Inflation %", "format": ".1f"}
        ]
      }
    }
  ]
}
