{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Food Price Inflation by Malaysian State",
    "subtitle": "Annual % change in food CPI, June 2023.",
    "anchor": "start",
    "fontSize": 15,
    "subtitleFontSize": 12
  },
  "width": 500,
  "height": 340,
  "projection": {
    "type": "mercator",
    "center": [109.5, 3.8],
    "scale": 1520,
    "translate": [250, 170]
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/clen0011-cell/fit2179-dv2/main/malaysia.topojson",
        "format": {"type": "topojson", "feature": "states"}
      },
      "transform": [
        {
          "lookup": "properties.Name",
          "from": {
            "data": {
              "url": "https://clen0011-cell.github.io/fit2179-dv2/data/cpi_state_2023.csv"
            },
            "key": "topo_name",
            "fields": ["inflation_yoy", "state"]
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#fff",
        "strokeWidth": 0.8
      },
      "encoding": {
        "color": {
          "field": "inflation_yoy",
          "type": "quantitative",
          "scale": {"scheme": "oranges", "domain": [3, 7]},
          "legend": {
            "title": "Inflation %",
            "orient": "none",
            "legendX": 420,
            "legendY": 260,
            "gradientLength": 80,
            "titleFontSize": 11,
            "labelFontSize": 10
          }
        },
        "tooltip": [
          {"field": "state", "title": "State"},
          {
            "field": "inflation_yoy",
            "title": "Food Inflation %",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "lat": 5.3,
            "lon": 117.8,
            "label": "Sabah → highest ~7%"
          },
          {
            "lat": 2.5,
            "lon": 113.5,
            "label": "Sarawak → above 5%"
          },
          {
            "lat": 3.1,
            "lon": 101.5,
            "label": "KL → lowest ~3%"
          },
          {
            "lat": 6.1,
            "lon": 102.2,
            "label": "Kelantan → above 5%"
          }
        ]
      },
      "layer": [
        {
          "mark": {
            "type": "text",
            "fontSize": 10,
            "fontStyle": "italic",
            "color": "black",
            "stroke": "white",
            "strokeWidth": 3,
            "strokeOpacity": 1
          },
          "encoding": {
            "latitude": {"field": "lat", "type": "quantitative"},
            "longitude": {"field": "lon", "type": "quantitative"},
            "text": {"field": "label"}
          }
        },
        {
          "mark": {
            "type": "text",
            "fontSize": 10,
            "fontStyle": "italic",
            "color": "#black"
          },
          "encoding": {
            "latitude": {"field": "lat", "type": "quantitative"},
            "longitude": {"field": "lon", "type": "quantitative"},
            "text": {"field": "label"}
          }
        }
      ]
    }
  ]
}
