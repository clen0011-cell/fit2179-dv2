{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Food Price Inflation by Malaysian State",
    "subtitle": "Annual % change in food CPI, 2023. Source: DOSM",
    "anchor": "start",
    "fontSize": 15,
    "subtitleFontSize": 12
  },
  "width": "container",
  "height": 420,
  "projection": {"type": "mercator"},
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/clen0011-cell/fit2179-dv2/main/malaysia.topojson",
        "format": {"type": "topojson", "feature": "states"}
      },
      "transform": [
        {
          "calculate": "datum.properties.Name == 'Penang' ? 'Pulau Pinang' : datum.properties.Name == 'Kuala Lumpur' ? 'W.P. Kuala Lumpur' : datum.properties.Name == 'Labuan' ? 'W.P. Labuan' : datum.properties.Name == 'Putrajaya' ? 'W.P. Putrajaya' : datum.properties.Name",
          "as": "csv_state"
        },
        {
          "lookup": "csv_state",
          "from": {
            "data": {"url": "data/cpi_state_inflation.csv"},
            "key": "state",
            "fields": ["inflation_yoy"]
          }
        },
        {
          "filter": "datum.date >= '2023-01-01' && datum.date <= '2023-12-31'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#fff",
        "strokeWidth": 0.8
      },
      "encoding": {
        "color": {
          "field": "inflation_yoy",
          "type": "quantitative",
          "aggregate": "mean",
          "scale": {"scheme": "orangered"},
          "legend": {"title": "Inflation %"}
        },
        "tooltip": [
          {"field": "properties.Name", "title": "State"},
          {
            "field": "inflation_yoy",
            "title": "Food Inflation %",
            "aggregate": "mean",
            "format": ".1f"
          }
        ]
      }
    }
  ]
}
