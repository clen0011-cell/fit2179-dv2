{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Food Price Inflation by Malaysian State",
    "subtitle": "Annual % change in food CPI (2023–2024)",
    "anchor": "start",
    "fontSize": 15,
    "subtitleFontSize": 12
  },
  "width": "container",
  "height": 420,
  "projection": {"type": "mercator"},
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/clen0011-cell/fit2179-dv2/main/malaysia.topojson",
        "format": {"type": "topojson", "feature": "states"}
      },
      "transform": [
        {
          "lookup": "properties.Name",
          "from": {
            "data": {
              "values": [
                {"name": "Johor",        "inflation": 1.8},
                {"name": "Kedah",        "inflation": 0.6},
                {"name": "Kelantan",     "inflation": 1.2},
                {"name": "Melaka",       "inflation": 1.5},
                {"name": "Negeri Sembilan","inflation": 1.4},
                {"name": "Pahang",       "inflation": 1.9},
                {"name": "Perak",        "inflation": 0.5},
                {"name": "Perlis",       "inflation": 1.7},
                {"name": "Penang",       "inflation": 2.7},
                {"name": "Sabah",        "inflation": 1.6},
                {"name": "Sarawak",      "inflation": 1.8},
                {"name": "Selangor",     "inflation": 3.3},
                {"name": "Terengganu",   "inflation": 1.9},
                {"name": "Kuala Lumpur", "inflation": 1.5},
                {"name": "Labuan",       "inflation": 1.6},
                {"name": "Putrajaya",    "inflation": 2.5}
              ]
            },
            "key": "name",
            "fields": ["inflation"]
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#fff",
        "strokeWidth": 0.8
      },
      "encoding": {
        "color": {
          "field": "inflation",
          "type": "quantitative",
          "scale": {"scheme": "orangered", "domain": [0, 3.5]},
          "legend": {"title": "Inflation %"}
        },
        "tooltip": [
          {"field": "properties.Name", "title": "State"},
          {"field": "inflation", "title": "Food Inflation %", "format": ".1f"}
        ]
      }
    }
  ]
}
