{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Is Food Inflation Seasonal?",
    "subtitle": "Average monthly food CPI change (%) by month, 2015–2023. Source: DOSM",
    "anchor": "start",
    "fontSize": 15,
    "subtitleFontSize": 12
  },
  "width": 400,
  "height": 400,
  "data": {"url": "data/cpi_national.csv"},
  "transform": [
    {"filter": "datum.division == '01'"},
    {"calculate": "month(datum.date)", "as": "month_num"},
    {"calculate": "datum.month_num == 0 ? 'Jan' : datum.month_num == 1 ? 'Feb' : datum.month_num == 2 ? 'Mar' : datum.month_num == 3 ? 'Apr' : datum.month_num == 4 ? 'May' : datum.month_num == 5 ? 'Jun' : datum.month_num == 6 ? 'Jul' : datum.month_num == 7 ? 'Aug' : datum.month_num == 8 ? 'Sep' : datum.month_num == 9 ? 'Oct' : datum.month_num == 10 ? 'Nov' : 'Dec'", "as": "month_name"},
    {"filter": "year(datum.date) >= 2015 && year(datum.date) <= 2023"},
    {
      "aggregate": [{"op": "mean", "field": "index", "as": "avg_index"}],
      "groupby": ["month_num", "month_name"]
    }
  ],
  "layer": [
    {
      "mark": {"type": "arc", "innerRadius": 80, "stroke": "#fff", "strokeWidth": 1},
      "encoding": {
        "theta": {
          "field": "month_num",
          "type": "quantitative",
          "scale": {"domain": [0, 12]}
        },
        "theta2": {
          "datum": 1
        },
        "radius": {
          "field": "avg_index",
          "type": "quantitative",
          "scale": {"zero": false, "range": [80, 180]}
        },
        "color": {
          "field": "avg_index",
          "type": "quantitative",
          "scale": {"scheme": "oranges"},
          "legend": {"title": "Avg CPI Index"}
        },
        "tooltip": [
          {"field": "month_name", "title": "Month"},
          {"field": "avg_index",  "title": "Avg Food CPI", "format": ".1f"}
        ]
      }
    },
    {
      "mark": {"type": "text", "radius": 200, "fontSize": 11},
      "encoding": {
        "theta": {
          "field": "month_num",
          "type": "quantitative",
          "scale": {"domain": [0, 12]},
          "band": 0.5
        },
        "text": {"field": "month_name"},
        "color": {"value": "#444"}
      }
    }
  ]
}
