{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Food Price Trends Across All States",
    "subtitle": "Monthly food CPI index (2010 = 100) per state",
    "anchor": "start",
    "fontSize": 15,
    "subtitleFontSize": 12
  },
  "data": {"url": "data/cpi_state.csv"},
  "transform": [
    {"filter": "datum.division == '01'"}
  ],
  "facet": {
    "field": "state",
    "type": "nominal",
    "columns": 4,
    "header": {
      "titleFontSize": 0,
      "labelFontSize": 10,
      "labelFontWeight": "bold",
      "labelColor": "#444"
    }
  },
  "spec": {
    "width": 150,
    "height": 70,
    "mark": {
      "type": "line",
      "color": "#c0392b",
      "strokeWidth": 1.5
    },
    "encoding": {
      "x": {
        "field": "date",
        "type": "temporal",
        "axis": {
          "labels": false,
          "ticks": false,
          "title": null,
          "grid": false,
          "domain": false
        }
      },
      "y": {
        "field": "index",
        "type": "quantitative",
        "axis": {
          "title": null,
          "grid": false,
          "tickCount": 3
        },
        "scale": {"zero": false}
      },
      "tooltip": [
        {"field": "state", "title": "State"},
        {"field": "date", "type": "temporal", "title": "Date"},
        {"field": "index", "title": "Food CPI", "format": ".1f"}
      ]
    }
  },
  "resolve": {"scale": {"y": "independent"}}
}
