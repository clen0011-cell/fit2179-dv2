{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Food Price Trends: Key States Compared",
    "subtitle": "Monthly food CPI index (2010 = 100)",
    "anchor": "start",
    "fontSize": 15,
    "subtitleFontSize": 12
  },
  "data": {"url": "data/cpi_state.csv"},
  "transform": [
    {"filter": "datum.division == '01'"},
    {"filter": "datum.state == 'Selangor' || datum.state == 'Perak' || datum.state == 'Sarawak' || datum.state == 'W.P. Kuala Lumpur'"}
  ],
  "facet": {
    "field": "state",
    "type": "nominal",
    "columns": 2,
    "rows": 2,
    "header": {
      "titleFontSize": 0,
      "labelFontSize": 11,
      "labelFontWeight": "bold",
      "labelColor": "#444"
    }
  },
  "spec": {
    "width": 180,
    "height": 100,
    "mark": {
      "type": "line",
      "color": "#D55E00",
      "strokeWidth": 2
    },
    "encoding": {
      "x": {
        "field": "date",
        "type": "temporal",
        "axis": null
      },
      "y": {
        "field": "index",
        "type": "quantitative",
        "axis": {"tickCount": 3, "title": null},
        "scale": {"zero": false}
      },
      "tooltip": [
        {"field": "state", "title": "State"},
        {"field": "date", "type": "temporal", "title": "Date"},
        {"field": "index", "title": "Food CPI", "format": ".1f"}
      ]
    }
  },
  "resolve": {"scale": {"y": "independent"}},
  "spacing": 20
}
