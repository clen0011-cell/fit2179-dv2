{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Average Household Expenditure by State (2022)",
    "subtitle": "Monthly mean expenditure (RM) — states sorted by expenditure level",
    "anchor": "start",
    "fontSize": 15,
    "subtitleFontSize": 12
  },
  "width": "container",
  "height": 380,
  "data": {"url": "data/hies_state.csv"},
  "layer": [
    {
      "mark": {"type": "bar", "cornerRadiusEnd": 4},
      "encoding": {
        "y": {
          "field": "state",
          "type": "nominal",
          "sort": "-x",
          "title": null
        },
        "x": {
          "field": "expenditure_mean",
          "type": "quantitative",
          "title": "Mean Monthly Expenditure (RM)",
          "axis": {"grid": false}
        },
        "color": {
          "field": "poverty",
          "type": "quantitative",
          "scale": {"scheme": "orangered"},
          "legend": {"title": "Poverty Rate (%)"}
        },
        "tooltip": [
          {"field": "state",            "title": "State"},
          {"field": "expenditure_mean", "title": "Mean Expenditure (RM)", "format": ",.0f"},
          {"field": "income_mean",      "title": "Mean Income (RM)",      "format": ",.0f"},
          {"field": "poverty",          "title": "Poverty Rate (%)",      "format": ".1f"}
        ]
      }
    }
  ]
}
