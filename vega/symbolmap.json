{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Food Price Inflation Across Southeast Asia",
    "subtitle": "Average Food CPI (2022, base 2015 = 100). Circle size = price level. Source: FAO",
    "anchor": "start",
    "fontSize": 15,
    "subtitleFontSize": 12
  },
  "width": "container",
  "height": 420,
  "projection": {
    "type": "equirectangular",
    "center": [110, 12],
    "scale": 750
  },
  "layer": [
    {
      "data": {"values": [{"x": 0}]},
      "mark": {"type": "rect", "fill": "#A8D8EA"},
      "encoding": {}
    },
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/world-atlas@2/countries-110m.json",
        "format": {"type": "topojson", "feature": "countries"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "#d4e8c2",
        "stroke": "#aaa",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {"url": "data/fao_avg_2022.csv"},
      "transform": [
        {
          "lookup": "country",
          "from": {
            "data": {
              "values": [
                {"country": "Brunei Darussalam",               "lat": 4.5353,  "lon": 114.7277},
                {"country": "Cambodia",                         "lat": 12.5657, "lon": 104.9910},
                {"country": "Indonesia",                        "lat": -0.7893, "lon": 113.9213},
                {"country": "Lao People's Democratic Republic", "lat": 19.8563, "lon": 102.4955},
                {"country": "Malaysia",                         "lat": 4.2105,  "lon": 101.9758},
                {"country": "Myanmar",                          "lat": 19.1633, "lon": 96.0785},
                {"country": "Philippines",                      "lat": 12.8797, "lon": 122.5000},
                {"country": "Singapore",                        "lat": 1.3521,  "lon": 103.8198},
                {"country": "Thailand",                         "lat": 15.8700, "lon": 100.9925},
                {"country": "Viet Nam",                         "lat": 14.0583, "lon": 108.2772}
              ]
            },
            "key": "country",
            "fields": ["lat", "lon"]
          }
        }
      ],
      "mark": {
        "type": "circle",
        "opacity": 0.85,
        "stroke": "#fff",
        "strokeWidth": 1.5
      },
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude":  {"field": "lat", "type": "quantitative"},
        "size": {
          "field": "avg_cpi",
          "type": "quantitative",
          "scale": {"range": [300, 3000]},
          "legend": {"title": "Food CPI Index"}
        },
        "color": {
          "field": "avg_cpi",
          "type": "quantitative",
          "scale": {"scheme": "oranges"},
          "legend": null
        },
        "tooltip": [
          {"field": "country", "title": "Country"},
          {"field": "avg_cpi", "title": "Avg Food CPI (2022)", "format": ".1f"}
        ]
      }
    },
    {
      "data": {"url": "data/fao_avg_2022.csv"},
      "transform": [
        {
          "lookup": "country",
          "from": {
            "data": {
              "values": [
                {"country": "Brunei Darussalam",               "lat": 4.5353,  "lon": 114.7277},
                {"country": "Cambodia",                         "lat": 12.5657, "lon": 104.9910},
                {"country": "Indonesia",                        "lat": -0.7893, "lon": 113.9213},
                {"country": "Lao People's Democratic Republic", "lat": 19.8563, "lon": 102.4955},
                {"country": "Malaysia",                         "lat": 4.2105,  "lon": 101.9758},
                {"country": "Myanmar",                          "lat": 19.1633, "lon": 96.0785},
                {"country": "Philippines",                      "lat": 12.8797, "lon": 122.5000},
                {"country": "Singapore",                        "lat": 1.3521,  "lon": 103.8198},
                {"country": "Thailand",                         "lat": 15.8700, "lon": 100.9925},
                {"country": "Viet Nam",                         "lat": 14.0583, "lon": 108.2772}
              ]
            },
            "key": "country",
            "fields": ["lat", "lon"]
          }
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "text",
            "dy": -18,
            "fontSize": 11,
            "fontWeight": "bold",
            "color": "white",
            "stroke": "white",
            "strokeWidth": 4,
            "strokeOpacity": 1
          },
          "encoding": {
            "longitude": {"field": "lon", "type": "quantitative"},
            "latitude":  {"field": "lat", "type": "quantitative"},
            "text":      {"field": "country"}
          }
        },
        {
          "mark": {
            "type": "text",
            "dy": -18,
            "fontSize": 11,
            "fontWeight": "bold",
            "color": "#111"
          },
          "encoding": {
            "longitude": {"field": "lon", "type": "quantitative"},
            "latitude":  {"field": "lat", "type": "quantitative"},
            "text":      {"field": "country"}
          }
        }
      ]
    }
  ]
}
