{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Food Price Inflation Across Southeast Asia",
    "subtitle": "Average Food CPI index (2023, base 2015 = 100). Circle size = price level. Source: FAO",
    "anchor": "start",
    "fontSize": 15,
    "subtitleFontSize": 12
  },
  "width": "container",
  "height": 420,
  "projection": {
  "type": "equirectangular",
  "center": [118, 5],
  "scale": 1800
},
  "layer": [
    {
      "data": {"values": [{"x": 0}]},
      "mark": {"type": "rect", "fill": "#A8D8EA"},
      "encoding": {}
    },
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/world-atlas@2/countries-110m.json",
        "format": {"type": "topojson", "feature": "countries"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "#d4e8c2",
        "stroke": "#aaa",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {"url": "data/fao_avg_2023.csv"},
      "mark": {
        "type": "circle",
        "opacity": 0.85,
        "stroke": "#fff",
        "strokeWidth": 1.5
      },
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude":  {"field": "lat", "type": "quantitative"},
        "size": {
          "field": "avg_cpi",
          "type": "quantitative",
          "scale": {"range": [200, 3000]},
          "legend": {"title": "Food CPI Index"}
        },
        "color": {
          "field": "avg_cpi",
          "type": "quantitative",
          "scale": {"scheme": "oranges"},
          "legend": null
        },
        "tooltip": [
          {"field": "country", "title": "Country"},
          {"field": "avg_cpi", "title": "Avg Food CPI (2023)", "format": ".1f"}
        ]
      }
    },
    {
      "data": {"url": "data/fao_avg_2023.csv"},
      "mark": {
        "type": "text",
        "dy": -18,
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#333"
      },
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude":  {"field": "lat", "type": "quantitative"},
        "text": {"field": "country"}
      }
    }
  ]
}
