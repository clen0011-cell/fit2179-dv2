{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Food Price Inflation Across Southeast Asia",
    "subtitle": "Food CPI index (2023). Circle size = inflation level.",
    "anchor": "start",
    "fontSize": 15,
    "subtitleFontSize": 12
  },
  "width": "container",
  "height": 380,
  "projection": {"type": "equirectangular"},
  "layer": [
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/world-atlas@2/countries-110m.json",
        "format": {"type": "topojson", "feature": "countries"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e8e0d4",
        "stroke": "#fff",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {"url": "data/fao_sea.csv"},
      "transform": [
        {"filter": "datum.Year == 2023"},
        {"filter": "datum.Element == 'Food Consumer Price Index'"},
        {
          "lookup": "Area",
          "from": {
            "data": {
              "values": [
                {"Area": "Malaysia",     "latitude": 4.2105,  "longitude": 101.9758},
                {"Area": "Thailand",     "latitude": 15.8700, "longitude": 100.9925},
                {"Area": "Indonesia",    "latitude": -0.7893, "longitude": 113.9213},
                {"Area": "Philippines",  "latitude": 12.8797, "longitude": 121.7740},
                {"Area": "Singapore",    "latitude": 1.3521,  "longitude": 103.8198},
                {"Area": "Viet Nam",     "latitude": 14.0583, "longitude": 108.2772}
              ]
            },
            "key": "Area",
            "fields": ["latitude", "longitude"]
          }
        }
      ],
      "mark": {
        "type": "circle",
        "opacity": 0.8,
        "stroke": "#fff",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude":  {"field": "latitude",  "type": "quantitative"},
        "size": {
          "field": "Value",
          "type": "quantitative",
          "scale": {"range": [200, 2500]},
          "legend": {"title": "Food CPI Index"}
        },
        "color": {
          "field": "Value",
          "type": "quantitative",
          "scale": {"scheme": "orangered"},
          "legend": {"title": "Food CPI Index"}
        },
        "tooltip": [
          {"field": "Area",  "title": "Country"},
          {"field": "Year",  "title": "Year"},
          {"field": "Value", "title": "Food CPI Index", "format": ".1f"}
        ]
      }
    }
  ]
}
