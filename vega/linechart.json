{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Two Decades of Rising Food Prices in Malaysia",
    "subtitle": "Monthly food CPI index (base 2010 = 100). Source: DOSM",
    "anchor": "start",
    "fontSize": 15,
    "subtitleFontSize": 12
  },
  "width": "container",
  "height": 300,
  "data": {"url": "data/cpi_national.csv"},
  "transform": [
    {"filter": "datum.division === '01'"}
  ],
  "mark": {
    "type": "line",
    "color": "#c0392b",
    "strokeWidth": 2.5
  },
  "encoding": {
    "x": {
      "field": "date",
      "type": "temporal",
      "title": "Year"
    },
    "y": {
      "field": "index",
      "type": "quantitative",
      "title": "Food Price Index (2010 = 100)",
      "scale": {"zero": false}
    },
    "tooltip": [
      {"field": "date",  "type": "temporal",    "title": "Date"},
      {"field": "index", "type": "quantitative", "title": "Food CPI", "format": ".1f"}
    ]
  }
}
