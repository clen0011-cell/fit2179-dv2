{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Malaysia Food CPI, 2010–2025",
    "subtitle": "Base year = 2010. Higher values mean higher prices.",
    "fontSize": 15,
    "subtitleFontSize": 12,
    "anchor": "start"
  },
  "width": "container",
  "height": 300,
  "data": {
    "url": "data/cpi_national.csv"
  },
  "transform": [
    {"filter": "datum.division == '01'"},
    {"calculate": "year(datum.date)", "as": "year"},
    {
      "aggregate": [{"op": "mean", "field": "index", "as": "avg_index"}],
      "groupby": ["year"]
    },
    {"calculate": "new Date(datum.year, 0, 1)", "as": "year_date"}
  ],
  "mark": {
    "type": "line",
    "color": "#c0392b",
    "strokeWidth": 2.5,
    "point": true
  },
  "encoding": {
    "x": {
      "field": "year_date",
      "type": "temporal",
      "title": "Year"
    },
    "y": {
      "field": "avg_index",
      "type": "quantitative",
      "title": "Food Price Index"
    },
    "tooltip": [
      {"field": "year", "title": "Year", "type": "nominal"},
      {"field": "avg_index", "title": "Avg CPI", "format": ".1f"}
    ]
  }
}
