{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Malaysia Food Prices: 45 Years of Change",
    "subtitle": "Monthly food CPI index (base 2010 = 100). Source: DOSM",
    "anchor": "start",
    "fontSize": 15,
    "subtitleFontSize": 12
  },
  "width": "container",
  "height": 320,
  "data": {"url": "data/cpi_national.csv"},
  "transform": [{"filter": "datum.division == '01'"}],
  "layer": [
    {
      "mark": {"type": "line", "color": "#0072B2", "strokeWidth": 2.5},
      "encoding": {
        "x": {"field": "date", "type": "temporal", "title": "Year"},
        "y": {
          "field": "index",
          "type": "quantitative",
          "title": "Food Price Index (2010 = 100)",
          "scale": {"zero": false}
        },
        "tooltip": [
          {"field": "date",  "type": "temporal",    "title": "Date"},
          {"field": "index", "type": "quantitative", "title": "Food CPI", "format": ".1f"}
        ]
      }
    },
    {
      "data": {"values": [{"date": "2008-01-01"}]},
      "mark": {"type": "rule", "color": "#E69F00", "strokeDash": [5, 4], "strokeWidth": 1.8},
      "encoding": {"x": {"field": "date", "type": "temporal"}}
    },
    {
      "data": {"values": [{"date": "2020-03-01"}]},
      "mark": {"type": "rule", "color": "#CC79A7", "strokeDash": [5, 4], "strokeWidth": 1.8},
      "encoding": {"x": {"field": "date", "type": "temporal"}}
    },
    {
      "data": {"values": [{"date": "2022-06-01"}]},
      "mark": {"type": "rule", "color": "#009E73", "strokeDash": [5, 4], "strokeWidth": 1.8},
      "encoding": {"x": {"field": "date", "type": "temporal"}}
    },
    {
      "data": {
        "values": [
          {"date": "2008-01-01", "index": 130, "label": "Global food crisis"},
          {"date": "2020-03-01", "index": 148, "label": "COVID-19"},
          {"date": "2022-06-01", "index": 155, "label": "Subsidy cuts"}
        ]
      },
      "mark": {"type": "text", "align": "left", "dx": 5, "fontSize": 10},
      "encoding": {
        "x":     {"field": "date",  "type": "temporal"},
        "y":     {"field": "index", "type": "quantitative"},
        "text":  {"field": "label"},
        "color": {
          "field": "label",
          "type": "nominal",
          "scale": {
            "domain": ["Global food crisis", "COVID-19", "Subsidy cuts"],
            "range":  ["#E69F00",            "#CC79A7",  "#009E73"]
          },
          "legend": null
        }
      }
    }
  ]
}
