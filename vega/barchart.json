{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Which Foods Got More Expensive?",
    "subtitle": "Average annual food CPI inflation by category, 2023",
    "anchor": "start",
    "fontSize": 15,
    "subtitleFontSize": 12
  },
  "width": "container",
  "height": 320,
  "data": {
    "values": [
      {"label": "Food & Non-Alcoholic Drinks", "inflation": 4.83},
      {"label": "Alcoholic Drinks & Tobacco",  "inflation": 0.65},
      {"label": "Clothing & Footwear",         "inflation": 0.23},
      {"label": "Housing & Utilities",         "inflation": 1.66},
      {"label": "Furnishings",                 "inflation": 1.20},
      {"label": "Health",                      "inflation": 1.89},
      {"label": "Transport",                   "inflation": 0.45},
      {"label": "Communication",               "inflation": 0.10},
      {"label": "Recreation",                  "inflation": 0.98},
      {"label": "Education",                   "inflation": 2.10},
      {"label": "Restaurants & Hotels",        "inflation": 5.21},
      {"label": "Insurance & Finance",         "inflation": 3.40},
      {"label": "Misc Goods & Services",       "inflation": 1.75}
    ]
  },
  "mark": {"type": "bar", "cornerRadiusEnd": 4},
  "encoding": {
    "y": {
      "field": "label",
      "type": "nominal",
      "sort": "-x",
      "title": null
    },
    "x": {
      "field": "inflation",
      "type": "quantitative",
      "title": "Avg Inflation (%)",
      "axis": {"grid": false}
    },
    "color": {
      "field": "inflation",
      "type": "quantitative",
      "scale": {"scheme": "oranges"},
      "legend": null
    },
    "tooltip": [
      {"field": "label",     "title": "Category"},
      {"field": "inflation", "title": "Inflation %", "format": ".2f"}
    ]
  }
}
