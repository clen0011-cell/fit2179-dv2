{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Food Price Index by Country (2023)",
    "subtitle": "Average annual food CPI across Southeast Asia. Malaysia highlighted in red. Source: FAO",
    "anchor": "start",
    "fontSize": 15,
    "subtitleFontSize": 12
  },
  "width": "container",
  "height": 260,
  "data": {
    "values": [
      {"country": "Philippines", "cpi": 148.2},
      {"country": "Indonesia",   "cpi": 141.5},
      {"country": "Malaysia",    "cpi": 126.3},
      {"country": "Thailand",    "cpi": 122.8},
      {"country": "Singapore",   "cpi": 118.4}
    ]
  },
  "layer": [
    {
      "mark": {"type": "rule", "color": "#e8e0d4", "strokeWidth": 2},
      "encoding": {
        "y":  {"field": "country", "type": "nominal", "sort": "-x", "title": null},
        "x":  {"datum": 100},
        "x2": {"field": "cpi"}
      }
    },
    {
      "mark": {"type": "point", "filled": true, "size": 200},
      "encoding": {
        "y": {"field": "country", "type": "nominal", "sort": "-x", "title": null},
        "x": {
          "field": "cpi",
          "type": "quantitative",
          "title": "Food CPI Index (2015 = 100)",
          "scale": {"domain": [100, 160]},
          "axis": {"grid": false}
        },
        "color": {
          "condition": {"test": "datum.country == 'Malaysia'", "value": "#c0392b"},
          "value": "#f4a261"
        },
        "size": {
          "condition": {"test": "datum.country == 'Malaysia'", "value": 280},
          "value": 160
        },
        "tooltip": [
          {"field": "country", "title": "Country"},
          {"field": "cpi",     "title": "Food CPI Index (2023)", "format": ".1f"}
        ]
      }
    },
    {
      "mark": {"type": "text", "align": "left", "dx": 10, "fontSize": 12, "fontWeight": "bold"},
      "encoding": {
        "y": {"field": "country", "type": "nominal", "sort": "-x"},
        "x": {"field": "cpi", "type": "quantitative"},
        "text": {"field": "country"},
        "color": {
          "condition": {"test": "datum.country == 'Malaysia'", "value": "#c0392b"},
          "value": "#888"
        }
      }
    }
  ]
}
