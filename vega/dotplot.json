{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Food Price Index by Country (2023)",
    "subtitle": "Average annual food CPI across Southeast Asia. Malaysia highlighted. Source: FAO",
    "anchor": "start",
    "fontSize": 15,
    "subtitleFontSize": 12
  },
  "width": "container",
  "height": 260,
  "data": {"url": "data/fao_avg_2023.csv"},
  "layer": [
    {
      "mark": {"type": "rule", "color": "#e8e0d4", "strokeWidth": 2},
      "encoding": {
        "y":  {"field": "country", "type": "nominal", "sort": "-x", "title": null},
        "x":  {"datum": 100},
        "x2": {"field": "avg_cpi"}
      }
    },
    {
      "mark": {"type": "point", "filled": true, "size": 200},
      "encoding": {
        "y": {"field": "country", "type": "nominal", "sort": "-x", "title": null},
        "x": {
          "field": "avg_cpi",
          "type": "quantitative",
          "title": "Avg Food CPI Index (2015 = 100)",
          "scale": {"zero": false},
          "axis": {"grid": false}
        },
        "color": {
          "condition": {"test": "datum.country == 'Malaysia'", "value": "#c0392b"},
          "value": "#f4a261"
        },
        "size": {
          "condition": {"test": "datum.country == 'Malaysia'", "value": 280},
          "value": 160
        },
        "tooltip": [
          {"field": "country", "title": "Country"},
          {"field": "avg_cpi", "title": "Food CPI Index (2023)", "format": ".1f"}
        ]
      }
    },
    {
      "mark": {"type": "text", "align": "left", "dx": 10, "fontSize": 12},
      "encoding": {
        "y": {"field": "country", "type": "nominal", "sort": "-x"},
        "x": {"field": "avg_cpi", "type": "quantitative"},
        "text": {"field": "country"},
        "color": {
          "condition": {"test": "datum.country == 'Malaysia'", "value": "#c0392b"},
          "value": "#888"
        }
      }
    }
  ]
}
