{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Food Price Inflation by Malaysian State",
    "subtitle": "Annual % change in food CPI (2023–2024)",
    "anchor": "start",
    "fontSize": 15,
    "subtitleFontSize": 12
  },
  "width": "container",
  "height": 500,
  "projection": {
    "type": "mercator",
    "center": [102, 4.2],
    "scale": 4000
  },
  "layer": [
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/world-atlas@2/countries-110m.json",
        "format": {"type": "topojson", "feature": "countries"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f0f0f0",
        "stroke": "#ccc"
      }
    },
    {
      "data": {
        "values": [
          {"state": "Johor", "inflation": 1.74, "lat": 1.5, "lon": 103.8},
          {"state": "Kedah", "inflation": 0.66, "lat": 6.1, "lon": 100.5},
          {"state": "Kelantan", "inflation": 0.80, "lat": 5.8, "lon": 102.2},
          {"state": "Melaka", "inflation": 1.06, "lat": 2.2, "lon": 102.2},
          {"state": "Negeri Sembilan", "inflation": 1.17, "lat": 2.7, "lon": 101.9},
          {"state": "Pahang", "inflation": 2.02, "lat": 3.8, "lon": 103.3},
          {"state": "Perak", "inflation": 0.62, "lat": 4.5, "lon": 101.5},
          {"state": "Perlis", "inflation": 1.71, "lat": 6.4, "lon": 100.2},
          {"state": "Pulau Pinang", "inflation": 2.65, "lat": 5.4, "lon": 100.3},
          {"state": "Sabah", "inflation": 1.56, "lat": 5.3, "lon": 118.0},
          {"state": "Sarawak", "inflation": 1.88, "lat": 1.6, "lon": 111.3},
          {"state": "Selangor", "inflation": 3.32, "lat": 3.1, "lon": 101.5},
          {"state": "Terengganu", "inflation": 1.80, "lat": 5.3, "lon": 103.1},
          {"state": "W.P. Kuala Lumpur", "inflation": 1.34, "lat": 3.1, "lon": 101.7},
          {"state": "W.P. Labuan", "inflation": 1.41, "lat": 5.3, "lon": 115.2},
          {"state": "W.P. Putrajaya", "inflation": 2.41, "lat": 2.9, "lon": 101.7}
        ]
      },
      "mark": {
        "type": "circle",
        "opacity": 0.8,
        "stroke": "#fff",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "size": {
          "field": "inflation",
          "type": "quantitative",
          "scale": {"range": [200, 2000]},
          "legend": {"title": "Inflation %"}
        },
        "color": {
          "field": "inflation",
          "type": "quantitative",
          "scale": {"scheme": "orangered"},
          "legend": {"title": "Food Inflation (%)"}
        },
        "tooltip": [
          {"field": "state", "title": "State"},
          {"field": "inflation", "title": "Food Inflation (%)", "format": ".2f"}
        ]
      }
    }
  ]
}
