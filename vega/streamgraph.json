{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "How Each Category Drove Price Growth Over Time",
    "subtitle": "Stacked CPI index by category, 2010–2024.",
    "anchor": "start",
    "fontSize": 15,
    "subtitleFontSize": 12
  },
  "width": "container",
  "height": 320,
  "data": {"url": "data/cpi_national.csv"},
  "transform": [
    {"filter": "datum.division != 'overall'"},
    {
      "lookup": "division",
      "from": {
        "data": {
          "values": [
            {"division": "01", "label": "Food & Drinks"},
            {"division": "04", "label": "Housing"},
            {"division": "07", "label": "Transport"},
            {"division": "11", "label": "Restaurants"},
            {"division": "02", "label": "Other"},
            {"division": "03", "label": "Other"},
            {"division": "05", "label": "Other"},
            {"division": "06", "label": "Other"},
            {"division": "08", "label": "Other"},
            {"division": "09", "label": "Other"},
            {"division": "10", "label": "Other"},
            {"division": "12", "label": "Other"},
            {"division": "13", "label": "Other"}
          ]
        },
        "key": "division",
        "fields": ["label"]
      }
    },
    {
      "aggregate": [{"op": "sum", "field": "index", "as": "index"}],
      "groupby": ["date", "label"]
    }
  ],
  "mark": {"type": "area", "interpolate": "monotone"},
  "encoding": {
    "x": {
      "field": "date",
      "type": "temporal",
      "title": "Year",
      "axis": {"grid": false}
    },
    "y": {
      "field": "index",
      "type": "quantitative",
      "title": "CPI Index",
      "stack": "zero",
      "axis": {"grid": false}
    },
    "color": {
      "field": "label",
      "type": "nominal",
      "scale": {
        "domain": ["Food & Drinks", "Housing", "Transport", "Restaurants", "Other"],
        "range": ["#4e79a7", "#f28e2b", "#59a14f", "#e15759", "#d3d3d3"]
      },
      "legend": {"title": "Category", "orient": "right"}
    },
    "order": {
      "field": "label",
      "sort": ["Food & Drinks", "Housing", "Transport", "Restaurants", "Other"]
    },
    "tooltip": [
      {"field": "date",  "type": "temporal", "title": "Date"},
      {"field": "label", "title": "Category"},
      {"field": "index", "title": "CPI Index", "format": ".1f"}
    ]
  }
}
